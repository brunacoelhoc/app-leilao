# Usado so pelo docker-compose.yml (senha do Postgres DENTRO do container --
# nao precisa ser a mesma do seu Postgres local fora do Docker).
# As outras variaveis (JWT_SECRET, API_KEY etc.) sao lidas direto de
# BackEnd/.env, que ja existe e ja tem tudo configurado
POSTGRES_PASSWORD=troque-por-uma-senha-qualquer
